# .env.example: every setting OmniEngine reads, with safe defaults.
# Copy it once to .env (git ignores .env) and edit .env, never this file:
#   cp .env.example .env
# OmniEngine settings start with OMNIENGINE_ because Docker Compose lets variables
# exported in your shell override .env; the prefix keeps other projects from clashing.

# --- Model files --------------------------------------------------------------
# Folder holding one subfolder per model; mounted read-only into the vLLM container.
# Use an absolute path: docker compose does not expand "~".
OMNIENGINE_MODELS_DIR=/home/your-user/models

# --- Model to serve -----------------------------------------------------------
# Hugging Face repo id and the exact commit to use; `make pull-model` downloads it if missing.
OMNIENGINE_MODEL_ID=Qwen/Qwen3-4B-AWQ
OMNIENGINE_MODEL_REVISION=74d4bd2bd4bff9cafc9345221320bffb08b406a3
# Subfolder of OMNIENGINE_MODELS_DIR where this model lives.
OMNIENGINE_MODEL_DIR_NAME=Qwen3-4B-AWQ
# Stable name agents send as "model"; agents never see the real model name.
OMNIENGINE_MODEL_ALIAS=local-llm

# --- API server ---------------------------------------------------------------
# Host port of the OpenAI-compatible API; agents use http://localhost:<port>/v1.
OMNIENGINE_PORT=8000
# Optional key agents must send as "Authorization: Bearer <key>"; empty = no key.
OMNIENGINE_API_KEY=

# --- GPU memory and context ---------------------------------------------------
# Share of GPU memory vLLM may use for weights and KV cache (0 to 1).
OMNIENGINE_GPU_MEMORY_UTILIZATION=0.85
# Longest prompt plus answer, in tokens; measured and tuned in step 2b.7.
OMNIENGINE_MAX_MODEL_LEN=8192

# --- Hugging Face -------------------------------------------------------------
# Read directly by Hugging Face tools, so it keeps its standard name.
# Only needed to download gated models; Qwen3-4B-AWQ is not gated.
HF_TOKEN=
